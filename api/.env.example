# Transaction-mode pooler (IPv4, app queries)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler (migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# Supabase (para verificar JWTs en middleware)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."

PORT=3000

# Vista pública y PDF — URL del frontend SIN barra final
# En local: http://localhost:5173
# En producción: URL de Netlify (ej. https://presumemi.netlify.app)
FRONTEND_URL="http://localhost:5173"

# Bucket de Supabase Storage donde se guardan los PDFs generados
SUPABASE_STORAGE_BUCKET="presupuestos-pdf"

# Solo en producción — orígenes extra permitidos en CORS
# NETLIFY_URL="https://presumemi.netlify.app"
# CUSTOM_DOMAIN="https://tudominio.com"

# Solo en producción (Render lo inyecta automáticamente)
# PUPPETEER_CACHE_DIR="/opt/render/project/.puppeteer"
